# Supabase project — get these from your project's Settings → API
# (works with a free-tier supabase.com project or self-hosted Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — used by admin API routes and scripts/create-demo-users.mjs.
# Never expose this in the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Show the demo accounts hint on the login page.
# The accounts themselves are created by scripts/create-demo-users.mjs.
NEXT_PUBLIC_DEMO_MODE=true

# Canonical site URL for OpenGraph/sitemap metadata.
# On Vercel leave unset - VERCEL_PROJECT_PRODUCTION_URL is picked up automatically.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# Google Search Console verification token (optional). Set it, redeploy, and the
# verification meta tag appears on every page.
# Get the token: search.google.com/search-console -> add property -> HTML tag method.
# GOOGLE_SITE_VERIFICATION=your-token-here
